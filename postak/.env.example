DEBUG=true
SECRET_KEY=zmente-me-lokalne
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8015,http://localhost:8015
# Prázdné FORCE_SCRIPT_NAME = vlastní doména v kořeni.
FORCE_SCRIPT_NAME=/postak
# Volitelné v DEBUG (jinak odvozeno ze SECRET_KEY). V produkci povinné:
# POSTAK_MAIL_ENCRYPTION_KEY=
# Moderník partner-admin API (LOCAL)
MODERNIK_API_BASE=http://127.0.0.1:8000/partner-admin/api/postak/v1
MODERNIK_API_TOKEN=dev-postak-local
# HereYouAre — stejný token jako HYA_POSTAK_API_TOKEN v projektu HYA (.env)
HYA_API_BASE=http://127.0.0.1:8765/internal/postak/v1
HYA_POSTAK_API_TOKEN=
# Bunny.net Storage (LOCAL integrace — volitelné; bez toho lokální MEDIA_ROOT)
# POSTAK_BUNNY_ENABLED=false
# POSTAK_BUNNY_STORAGE_ZONE=wwweb
# POSTAK_BUNNY_ACCESS_KEY=
# POSTAK_BUNNY_API_BASE=https://storage.bunnycdn.com
# POSTAK_BUNNY_ROOT_PREFIX=postak/local
# Systémové e-maily (přihlašovací údaje) — ID schránky v DB; prázdné = první schránka se stavem OK
# POSTAK_PUBLIC_LOGIN_URL=https://www.ulovklienty.cz/postak/
# POSTAK_SYSTEM_SCHRANKA_ID=
# Logo v uvítacím e-mailu (PNG s průhledností). Prázdné = …/static/postak-logo-email.png u přihlašovací URL
# POSTAK_EMAIL_LOGO_URL=
