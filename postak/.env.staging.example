# Pošťák STAGING — zkopírovat na server jako .env (nikdy do gitu).
DEBUG=false
SECRET_KEY=REPLACE_WITH_LONG_RANDOM
ALLOWED_HOSTS=www.staging.ulovklienty.cz,staging.ulovklienty.cz,ulov-staging-postak
CSRF_TRUSTED_ORIGINS=https://www.staging.ulovklienty.cz,https://staging.ulovklienty.cz
FORCE_SCRIPT_NAME=/postak

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postak_staging
POSTGRES_USER=postak
POSTGRES_PASSWORD=REPLACE

POSTAK_PUBLIC_LOGIN_URL=https://www.staging.ulovklienty.cz/postak/
POSTAK_MAIL_ENCRYPTION_KEY=REPLACE_BASE64_URLSAFE

# Moderník / HYA — výhradně STAGING API (ne LIVE)
MODERNIK_API_BASE=https://api-staging.ulovklienty.cz/partner-admin/api/postak/v1
MODERNIK_API_TOKEN=REPLACE_STAGING_TOKEN
HYA_API_BASE=https://api-staging.ulovklienty.cz/internal/postak/v1
HYA_POSTAK_API_TOKEN=REPLACE_OR_EMPTY_IF_MOCK

# Bunny.net — pouze prefix postak/staging/
POSTAK_BUNNY_ENABLED=true
POSTAK_BUNNY_STORAGE_ZONE=wwweb
POSTAK_BUNNY_ACCESS_KEY=REPLACE
POSTAK_BUNNY_ROOT_PREFIX=postak/staging
# POSTAK_EMAIL_LOGO_URL=https://www.staging.ulovklienty.cz/postak/static/postak-logo-email.png

# Systémový e-mail (uvítací údaje) — ID schránky v DB Pošťáka
# POSTAK_SYSTEM_SCHRANKA_ID=
