# Pošťák LIVE — zkopírovat jako postak/.env na serveru (mimo git).
DEBUG=false
SECRET_KEY=REPLACE_WITH_LONG_RANDOM
ALLOWED_HOSTS=www.ulovklienty.cz,ulovklienty.cz,ulov-live-postak
CSRF_TRUSTED_ORIGINS=https://www.ulovklienty.cz,https://ulovklienty.cz
FORCE_SCRIPT_NAME=/postak

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postak_live
POSTGRES_USER=postak
POSTGRES_PASSWORD=REPLACE

POSTAK_PUBLIC_LOGIN_URL=https://www.ulovklienty.cz/postak/
POSTAK_MAIL_ENCRYPTION_KEY=REPLACE_BASE64_URLSAFE

# Moderník — čtení/sync; zápis vypnut (POSTAK_MODERNIK_CRM_WRITE=false) do vyřešení DELETE/migrace
MODERNIK_API_BASE=https://api.ulovklienty.cz/partner-admin/api/postak/v1
MODERNIK_API_TOKEN=REPLACE_LIVE_TOKEN
POSTAK_MODERNIK_CRM_WRITE=false

# HYA — zatím odpojeno
HYA_API_BASE=
HYA_POSTAK_API_TOKEN=
POSTAK_HYA_CRM_WRITE=false

POSTAK_BUNNY_ENABLED=true
POSTAK_BUNNY_STORAGE_ZONE=wwweb
POSTAK_BUNNY_ACCESS_KEY=REPLACE
POSTAK_BUNNY_ROOT_PREFIX=postak
# POSTAK_EMAIL_LOGO_URL=https://www.ulovklienty.cz/postak/static/postak-logo-email.png
# POSTAK_SYSTEM_SCHRANKA_ID=
